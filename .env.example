# Copy this file to .env.local and fill it in. .env.local is gitignored. Never commit real keys.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Server-side only: read by api/diagnose.js on Vercel and by the Vite dev server locally.
# Don't give it a VITE_ prefix; that would bundle it into the browser code.
GEMINI_API_KEY=
